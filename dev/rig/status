# What the rig on this machine has built and is running. It cannot see
# another machine: whether a rig is up somewhere else is something to
# check there (dev/rig/README.md, "One rig at a time").
set -euo pipefail
source "$(dirname "$0")/lib.sh"

echo "config  $rig_env"
echo "state   $RIG_STATE"
echo
for b in switchboard core-agent cloudflared; do
  p="$RIG_STATE/bin/$b"
  if [[ ! -x $p ]]; then
    printf '%-12s not built\n' "$b"
    continue
  fi
  case "$b" in
    switchboard) v="$("$p" version 2>&1 | head -1)" || true ;;
    *) v="$("$p" --version 2>&1 | head -1)" || true ;;
  esac
  printf '%-12s %s\n' "$b" "$v"
done
if [[ -f $RIG_STATE/core-agent.commit ]]; then
  echo
  echo "core-agent was built from $(<"$RIG_STATE/core-agent.commit")."
  now="$(rig_resolve_ref "${RIG_CORE_AGENT_REPO:-https://github.com/go-steer/core-agent}" "${RIG_CORE_AGENT_REF:-main}" 2>/dev/null)" || true
  echo "${RIG_CORE_AGENT_REF:-main} is now ${now:-(could not ask the remote)}"
fi
if [[ -s $RIG_STATE/tunnel-url ]]; then
  echo
  echo "tunnel  $(<"$RIG_STATE/tunnel-url")/chat"
fi
echo
procs="$(rig_procs)"
if [[ -n $procs ]]; then
  echo "running:"
  printf '%s\n' "$procs"
else
  echo "nothing running"
fi
