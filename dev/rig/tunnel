# A cloudflared quick tunnel to the Chat gateway's HTTP listener, for
# dev/rig/chat --http. The URL is random and changes every time this
# starts, and the Chat console has to name it, so keep the tunnel up and
# restart the gateway behind it instead. The URL is written to the state
# directory, which is where dev/rig/chat --http reads it from.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

cloudflared="$(rig_bin cloudflared)"
url_file="$RIG_STATE/tunnel-url"
log="$RIG_STATE/logs/tunnel-$(date +%Y%m%dT%H%M%S).log"
rm -f "$url_file"

"$cloudflared" tunnel --no-autoupdate --url "http://127.0.0.1:$RIG_CHAT_LISTEN_PORT" >"$log" 2>&1 &
pid=$!
trap 'kill "$pid" 2>/dev/null; rm -f "$url_file"' EXIT INT TERM

url=""
for _ in $(seq 60); do
  url="$(grep -Eo 'https://[a-z0-9-]+\.trycloudflare\.com' "$log" | head -1 || true)"
  [[ -z $url ]] || break
  kill -0 "$pid" 2>/dev/null || { cat "$log" >&2; rig_die "cloudflared exited"; }
  sleep 0.5
done
[[ -n $url ]] || { cat "$log" >&2; rig_die "cloudflared printed no URL in 30s"; }
printf '%s\n' "$url" >"$url_file"

cat <<EOF

Tunnel up: $url -> 127.0.0.1:$RIG_CHAT_LISTEN_PORT   (log: $log)

Set the Chat app's endpoint to this URL, then start the gateway:

  Google Cloud console -> Google Chat API -> Configuration
    -> Connection settings -> HTTP endpoint URL:  $url/chat

  dev/rig/chat --http

The URL dies with this process. Leave it running across gateway restarts;
when you are done, point the console back (dev/rig/README.md, "Handing back").
EOF

wait "$pid"
