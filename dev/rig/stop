# Stop everything the rig runs on this machine. `pkill -f switchboard`
# is the tempting alternative and the wrong one: it matches the wrapper
# shells and anything else with the word in its command line, and misses
# a binary started under another name.
set -euo pipefail
source "$(dirname "$0")/lib.sh"

procs="$(rig_procs)"
if [[ -z $procs ]]; then
  echo "nothing running"
  exit 0
fi
printf '%s\n' "$procs"
# shellcheck disable=SC2086 # one PID per word
kill $(awk '{print $1}' <<<"$procs") 2>/dev/null || true # one may have exited already
for _ in $(seq 20); do
  [[ -n $(rig_procs) ]] || { echo "stopped"; exit 0; }
  sleep 0.5
done
echo "still running after 10s:" >&2
rig_procs >&2
exit 1
