# dev/rig configuration for one machine. Copy it out of the repo:
#
#   mkdir -p ~/.config/switchboard-rig && chmod 700 ~/.config/switchboard-rig
#   cp dev/rig/rig.env.example ~/.config/switchboard-rig/rig.env
#
# (SWITCHBOARD_RIG_ENV names a different path.) It is sourced by bash, so
# it is shell syntax. Nothing in it is a secret: secrets live in the files
# it points at, never in this file. The values filled in below are the
# go-steer rig's (project gke-demos-345619); replace them for your own.

# --- Daemon -----------------------------------------------------------------

# Who may talk to the rig: the identities switchboard asserts for a human,
# which are email addresses on both platforms. Space-separated.
RIG_CALLERS="you@example.com"

# The model. echo needs no credentials and answers instantly, which is
# enough to test transport. A real model on Vertex uses your own gcloud
# Application Default Credentials (gcloud auth application-default login).
RIG_MODEL="gemini-3.7-flash"
RIG_PROVIDER="vertex"
RIG_VERTEX_PROJECT="gke-demos-345619"
RIG_VERTEX_LOCATION="global" # gemini-3.7-flash is global-only

# yolo runs every tool without asking. ask makes the agent ask first, which
# is what testing approvals needs (and the built-in allow list goes off too).
RIG_PERMISSIONS="yolo"

# core-agent is built from this ref of go-steer/core-agent: test against
# its current main, not a release.
#RIG_CORE_AGENT_REF="main"
# The persona, a path inside that core-agent tree; RIG_PERSONA names a
# local file instead, or none.
#RIG_PERSONA_PATH="examples/gke-platform-agent/AGENTS.md"
#RIG_PERSONA="none"

#RIG_DAEMON_PORT=7777

# --- Google Chat ------------------------------------------------------------

# The Chat app's service-account key, readable by you only (chmod 600).
# Leave it unset to use Application Default Credentials, which then have to
# act as the Chat app's service account (untested, see the README).
RIG_CHAT_CREDENTIALS="$HOME/.config/switchboard-rig/switchboard-chat.json"

# Pub/Sub ingress (dev/rig/chat): where the Chat app publishes events.
RIG_CHAT_PROJECT="gke-demos-345619"
RIG_CHAT_SUBSCRIPTION="switchboard-chat-sub"

# HTTP ingress (dev/rig/chat --http): the add-on service account that signs
# every request, from the console's Connection settings page.
RIG_CHAT_ADDON_SA="service-1067056737933@gcp-sa-gsuiteaddons.iam.gserviceaccount.com"
# A fixed public URL in place of dev/rig/tunnel's random one.
#RIG_CHAT_ENDPOINT_URL="https://example.com/chat"
#RIG_CHAT_LISTEN_PORT=8081

# pubsub or http, when dev/rig/chat is run without --http.
RIG_CHAT_INGRESS="pubsub"
# off, status or rich (CARDS= overrides it for one run).
RIG_CHAT_CARDS="status"
# Extra switchboard serve flags, split on spaces. --googlechat-log-events
# writes message text and sender identity to the log; the logs stay in the
# state directory, but scrub anything before it becomes a committed fixture.
RIG_CHAT_ARGS="--googlechat-commands 1=progress --googlechat-log-events"

# Where Chat should send events once you are done (README, "Handing back").
# Not read by any script; it is here so every machine has it written down.
RIG_CHAT_HOME_ENDPOINT="https://switchboard-chat.demo.gke.ninja/chat"

# --- Slack ------------------------------------------------------------------

# A file setting SWITCHBOARD_SLACK_APP_TOKEN and SWITCHBOARD_SLACK_BOT_TOKEN
# for the rig's own Slack app, readable by you only (chmod 600). Use an app
# nothing else connects as: see the README.
RIG_SLACK_ENV="$HOME/.config/switchboard-rig/slack.env"
# What dev/rig/slack --manifest names the app and its slash command.
#RIG_SLACK_APP_NAME="switchboard-dev"
# Extra switchboard serve flags, split on spaces.
RIG_SLACK_ARGS="--slack-rich-blocks --show-usage"

# --- State ------------------------------------------------------------------

# Binaries, the daemon's token and session database, the tunnel URL, logs.
#RIG_STATE="$HOME/.local/state/switchboard-rig"
