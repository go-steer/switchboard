# Presubmit: fail if `go mod tidy` would change go.mod / go.sum. Runs the
# tidy against copies so it never mutates the tree, then diffs.
set -euo pipefail
cd "$(dirname "$0")/../../.."

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT
cp go.mod "$tmp/go.mod.orig"
[ -f go.sum ] && cp go.sum "$tmp/go.sum.orig" || : >"$tmp/go.sum.orig"

go mod tidy

ok=1
if ! diff -q "$tmp/go.mod.orig" go.mod >/dev/null; then ok=0; fi
if [ -f go.sum ]; then
  if ! diff -q "$tmp/go.sum.orig" go.sum >/dev/null; then ok=0; fi
elif [ -s "$tmp/go.sum.orig" ]; then
  ok=0
fi

if [ "$ok" -ne 1 ]; then
  # Restore the originals so a failing check leaves no dirty diff.
  cp "$tmp/go.mod.orig" go.mod
  [ -s "$tmp/go.sum.orig" ] && cp "$tmp/go.sum.orig" go.sum || rm -f go.sum
  echo "go.mod/go.sum are not tidy — run 'go mod tidy' and commit the result." >&2
  exit 1
fi
echo "go mod tidy: clean"
