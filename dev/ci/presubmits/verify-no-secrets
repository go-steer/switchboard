# Presubmit: no live credential in the tree. The dev rig (dev/rig) runs
# against real Slack and Google Chat apps, and its secrets are meant to live
# outside the checkout; this is the backstop for one that ends up inside
# anyway. It covers tracked files and untracked ones git is not ignoring,
# so a local run catches a key before `git add` does.
#
# The patterns are for the real shapes, not the prefixes: tests use
# placeholders like xoxb-1-2-abcdef and bare PEM headers, and those have
# to keep passing.
set -euo pipefail
cd "$(dirname "$0")/../../.."

patterns=(
  # A PEM private key block: a header alone on its line (a real key file),
  # or one followed by its body in a JSON string (a service-account key).
  '^[[:space:]]*-----BEGIN [A-Z ]*PRIVATE KEY-----[[:space:]]*$'
  'PRIVATE KEY-----\\n[A-Za-z0-9+/]{20,}'
  # The other half of a service-account key file.
  '"private_key_id"[[:space:]]*:[[:space:]]*"[0-9a-f]{40}"'
  # Slack bot/user/config tokens and app-level tokens, and the rotating
  # (xoxe.xoxb-1-...) and refresh (xoxe-1-...) forms token rotation issues.
  'xox[abposre]-[0-9]{6,}-[0-9A-Za-z-]{6,}'
  'xoxe(\.xox[a-z])?-[0-9]-[0-9A-Za-z-]{20,}'
  'xapp-[0-9]+-[A-Z0-9]{6,}-[0-9]+-[0-9a-f]{16,}'
  # Google API keys; GitHub classic and fine-grained tokens.
  'AIza[0-9A-Za-z_-]{35}'
  'gh[pousr]_[0-9A-Za-z]{36}'
  'github_pat_[0-9A-Za-z_]{60,}'
)
args=()
for p in "${patterns[@]}"; do
  args+=(-e "$p")
done

# -I skips binaries; --untracked --exclude-standard adds untracked files
# that are not ignored.
# git grep exits 1 for no match and above 1 for a failure, which must not
# read as a clean tree.
status=0
hits="$(git grep -nIE --untracked --exclude-standard "${args[@]}")" || status=$?
if (( status > 1 )); then
  echo "verify-no-secrets: git grep failed (exit $status)" >&2
  exit "$status"
fi
if (( status == 0 )); then
  echo "verify-no-secrets: these look like live credentials:" >&2
  # Name the place, not the value: the value is the thing not to print.
  cut -d: -f1,2 <<<"$hits" >&2
  echo >&2
  echo "Move them out of the repo (the dev rig reads them from ~/.config/switchboard-rig)." >&2
  echo "If one is a test fixture, make it a placeholder that does not have a real token's shape." >&2
  exit 1
fi
echo "no credentials found"
