# Presubmit: fail if any Go file is not gofmt-clean. Fix with `gofmt -w .`.
set -euo pipefail
cd "$(dirname "$0")/../../.."
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  echo "gofmt needed on:" >&2
  echo "$unformatted" >&2
  echo "run: gofmt -w ." >&2
  exit 1
fi
echo "gofmt: clean"
