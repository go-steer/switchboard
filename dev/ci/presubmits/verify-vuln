# Presubmit: govulncheck over all packages. Installs the pinned tool on
# demand if it isn't on PATH (matches core-agent's auto-install pattern).
set -euo pipefail
cd "$(dirname "$0")/../../.."

GOVULNCHECK_VERSION="${GOVULNCHECK_VERSION:-latest}"

if ! command -v govulncheck >/dev/null 2>&1; then
  echo "installing govulncheck@${GOVULNCHECK_VERSION}..." >&2
  GOBIN="$(go env GOPATH)/bin" go install "golang.org/x/vuln/cmd/govulncheck@${GOVULNCHECK_VERSION}"
  export PATH="$(go env GOPATH)/bin:$PATH"
fi

exec govulncheck ./...
