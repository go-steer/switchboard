# Stand up a throwaway core-agent daemon that switchboard can talk to:
# bearer-table auth with switchboard registered as a proxy identity, the
# echo provider by default, a real model on request. This is the daemon
# side of the live demo in docs/googlechat-setup.md; the config it writes
# is the same shape cmd/switchboard/integration_test.go stands up, so the
# integration suite is what keeps it honest.
#
# For demos and local testing only. It writes a bearer token to disk and
# prints it to the terminal, runs the agent with permissions.mode=yolo,
# and puts everything in a scratch directory. None of that belongs in a
# deployment.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dev/demo/daemon [options] [-- core-agent args...]

Options:
  --bin PATH        core-agent binary (default: $CORE_AGENT_BIN)
  --workdir DIR     scratch dir for config + session db (default: ./.demo-daemon)
  --port N          port the daemon listens on, loopback only (default: 7777)
  --caller IDENTITY register a caller switchboard may assert; repeatable
  --model NAME      model to run (default: echo)
  --provider NAME   provider flag to pass core-agent (default: echo, or none
                    once --model names something other than echo)
  -h, --help        this

The token comes from $SWITCHBOARD_DAEMON_TOKEN if set, otherwise a random
one is generated and printed. Export the same value for switchboard.

Anything after -- is appended to the core-agent command line verbatim, and
the daemon inherits this shell's environment — which is how a real model
gets its API key. The echo provider needs no credentials.

Build the binary first, in a core-agent checkout:

  go build -o /tmp/core-agent ./cmd/core-agent

Examples:
  dev/demo/daemon --bin /tmp/core-agent --caller you@example.com
  dev/demo/daemon --bin /tmp/core-agent --model claude-opus-5 --provider anthropic
EOF
}

bin="${CORE_AGENT_BIN:-}"
workdir=""
port=7777
callers=()
model="echo"
provider=""
provider_set=0
passthrough=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bin) bin="${2:?--bin needs a path}"; shift 2 ;;
    --workdir) workdir="${2:?--workdir needs a path}"; shift 2 ;;
    --port) port="${2:?--port needs a number}"; shift 2 ;;
    --caller) callers+=("${2:?--caller needs an identity}"); shift 2 ;;
    --model) model="${2:?--model needs a name}"; shift 2 ;;
    --provider) provider="${2:?--provider needs a name}"; provider_set=1; shift 2 ;;
    --) shift; passthrough=("$@"); break ;;
    -h|--help) usage; exit 0 ;;
    *) echo "unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# --provider defaults to echo, but only while the model is still echo:
# naming a real model and inheriting --provider=echo would silently run the
# echo provider anyway, which is the confusing failure this avoids. With a
# real model and no --provider, say nothing and let core-agent's own config
# resolution pick.
if (( ! provider_set )) && [[ $model == "echo" ]]; then
  provider="echo"
fi

if [[ -z $bin ]]; then
  echo "no core-agent binary: pass --bin or set \$CORE_AGENT_BIN" >&2
  echo "  go build -o /tmp/core-agent ./cmd/core-agent   # in a core-agent checkout" >&2
  exit 2
fi
if [[ ! -x $bin ]]; then
  echo "not an executable: $bin" >&2
  exit 2
fi
if [[ ! $port =~ ^[0-9]+$ ]] || (( port < 1 || port > 65535 )); then
  echo "not a port: $port" >&2
  exit 2
fi

# The identity strings land inside JSON string literals unescaped, so
# refuse anything that would need escaping rather than emitting a broken
# config. Chat resource names (users/123), emails, and sa:names all pass.
bot_identity="sa:switchboard-bot"
for id in "$bot_identity" ${callers+"${callers[@]}"}; do
  if [[ ! $id =~ ^[A-Za-z0-9._:@/+-]+$ ]]; then
    echo "identity has characters that need JSON escaping: $id" >&2
    exit 2
  fi
done
if [[ ! $model =~ ^[A-Za-z0-9._:@/+-]+$ ]]; then
  echo "model name has characters that need JSON escaping: $model" >&2
  exit 2
fi

token="${SWITCHBOARD_DAEMON_TOKEN:-}"
generated=0
if [[ -z $token ]]; then
  token="tok_$(od -An -tx1 -N18 /dev/urandom | tr -d ' \n')"
  generated=1
fi

# Stable by default, not mktemp: a demo is a loop of restarts, and a fresh
# directory each time would rotate the token and drop the session db under
# a running switchboard. .demo-daemon is git-ignored.
if [[ -z $workdir ]]; then
  workdir="$PWD/.demo-daemon"
fi
mkdir -p "$workdir"
workdir="$(cd "$workdir" && pwd)"
mkdir -p "$workdir/.agents"

users_file="$workdir/users.json"
config_file="$workdir/.agents/config.json"

# Callers get placeholder tokens: switchboard never presents them, it
# asserts the identity instead. They exist so the asserted identity is one
# the daemon already knows, which is what allow_anonymous=false requires.
# Distinct per caller, because a bearer table is a token -> identity
# lookup and a shared token would be ambiguous.
rows="    { \"identity\": \"$bot_identity\", \"token\": \"$token\" }"
n=0
for id in ${callers+"${callers[@]}"}; do
  n=$((n + 1))
  rows+=",
    { \"identity\": \"$id\", \"token\": \"tok_unused_caller_$n\" }"
done

umask 077
cat >"$users_file" <<EOF
{
  "version": 1,
  "users": [
$rows
  ]
}
EOF
chmod 600 "$users_file" # umask is advisory if the file already existed

cat >"$config_file" <<EOF
{
  "version": 1,
  "model": { "name": "$model" },
  "permissions": { "mode": "yolo" },
  "attach": {
    "listen": "127.0.0.1:$port",
    "multi_session": {
      "enabled": true,
      "auth": { "kind": "bearer_table", "table_file": "$users_file" },
      "proxy_identities": ["$bot_identity"],
      "default_identity": "anon",
      "allow_anonymous": false
    }
  }
}
EOF

args=(--no-repl --session-db --session-db-path="$workdir/session.db")
if [[ -n $provider ]]; then
  args=(--provider="$provider" "${args[@]}")
fi
args+=(${passthrough+"${passthrough[@]}"})

cat >&2 <<EOF
core-agent on 127.0.0.1:$port
  model    $model${provider:+ (provider $provider)}
  workdir  $workdir
  config   $config_file
  users    $users_file

Point switchboard at it with:

  export SWITCHBOARD_DAEMON_TOKEN=$token
  switchboard serve … --daemon-url http://127.0.0.1:$port

Both files are rewritten on every run, so make changes with flags, not by
editing them.

EOF
if (( generated )); then
  echo "The token above was generated for this run; it is not a secret worth keeping." >&2
fi
if [[ $model != "echo" ]]; then
  echo "Running a real model: core-agent inherits this shell's environment, so its API key has to be exported here." >&2
fi
if (( ${#callers[@]} == 0 )); then
  cat >&2 <<'EOF'
No --caller identities registered. Switchboard asserts an identity for the
human who sent the message, and allow_anonymous=false rejects one the table
does not know. If turns fail with "identity is not provisioned", take the
identity out of that error and rerun with --caller.

EOF
fi

cd "$workdir"
exec "$bin" "${args[@]}"
