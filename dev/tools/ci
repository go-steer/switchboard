# Full local CI in fast-fail order — the same scripts CI runs
# (dev/ci/presubmits/*). A green local run is the same green run as
# remote CI; run this before every push. Mirrors core-agent's
# dev/tools/ci.
set -euo pipefail

root="$(cd "$(dirname "$0")/../.." && pwd)"
presubmits="$root/dev/ci/presubmits"

# Fast-fail order: cheapest / most-likely-to-fail first.
checks=(
  verify-go-format
  vet
  build
  test-unit
  verify-mod-tidy
  verify-vuln
)

for c in "${checks[@]}"; do
  echo "=== $c ==="
  "$presubmits/$c"
done

echo "=== all presubmits passed ==="
