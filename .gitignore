# Personal agent-session context — intentionally not checked in. The shared
# instructions are AGENTS.md; the opt-in Claude Code config sample lives in
# dev/claude/settings-review-gate.json (repo-native enforcement is AGENTS.md
# + the required review-gate CI check, not committed harness settings).
CLAUDE.md
.claude/

# Go build artifacts
/switchboard
bin/
dist/
*.test
*.out
coverage.*

# Scratch config, session db, and bearer table written by dev/demo/daemon
# and dev/demo/slack-rig.
.demo-daemon/
.demo-rig/

# dev/rig keeps its config, secrets and state outside the checkout
# (~/.config/switchboard-rig, ~/.local/state/switchboard-rig). These catch
# a copy made here by mistake; dev/ci/presubmits/verify-no-secrets catches
# what they miss.
dev/rig/*.env
dev/rig/*.json
.rig/

# Editor / OS noise
.idea/
.vscode/
*.swp
.DS_Store
