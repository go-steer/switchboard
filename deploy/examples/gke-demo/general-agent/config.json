{
  "version": 1,
  "model": {
    "provider": "vertex",
    "name": "gemini-3.5-flash-lite"
  },
  "permissions": {
    "mode": "ask"
  },
  "checkpoint": {
    "mode": "operator"
  },
  "agent": {
    "display_name": "general",
    "max_turn_cost_usd": 0.1,
    "max_session_cost_usd": 1.0
  },
  "attach": {
    "listen": "0.0.0.0:7777",
    "multi_session": {
      "enabled": true,
      "session_idle_timeout": "6h",
      "auth": {
        "kind": "bearer_table",
        "table_file": "/etc/core-agent/users.json"
      },
      "admin_identities": [
        "garisingh@gke.ninja"
      ],
      "proxy_identities": [
        "sa:switchboard"
      ],
      "default_identity": "anon",
      "allow_anonymous": false
    }
  }
}
