{
  "platform": "slack",
  "daemon_url": "http://core-agent.switchboard.svc.cluster.local:7777",
  "caller_id": "email",
  "metrics_addr": ":9090",
  "token_env": "SWITCHBOARD_DAEMON_TOKEN",
  "defaults": {
    "progress_mode": "stream",
    "approvals": true,
    "show_usage": true
  },
  "slack_app_token_env": "SWITCHBOARD_SLACK_APP_TOKEN",
  "slack_bot_token_env": "SWITCHBOARD_SLACK_BOT_TOKEN",
  "slack_rich_blocks": true
}
