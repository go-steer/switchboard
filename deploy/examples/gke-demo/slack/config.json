{
  "platform": "slack",
  "agents": [
    {
      "name": "platform",
      "display_name": "Platform agent",
      "daemon_url": "http://core-agent.switchboard.svc.cluster.local:7777",
      "token_env": "SWITCHBOARD_DAEMON_TOKEN",
      "kind": "core-agent"
    },
    {
      "name": "general",
      "display_name": "General agent",
      "daemon_url": "http://general-agent.switchboard.svc.cluster.local:7777",
      "token_env": "SWITCHBOARD_DAEMON_TOKEN",
      "kind": "core-agent"
    }
  ],
  "default_agent": "platform",
  "caller_id": "email",
  "metrics_addr": ":9090",
  "defaults": {
    "progress_mode": "stream",
    "approvals": true,
    "show_usage": true
  },
  "slack_app_token_env": "SWITCHBOARD_SLACK_APP_TOKEN",
  "slack_bot_token_env": "SWITCHBOARD_SLACK_BOT_TOKEN",
  "slack_rich_blocks": true
}
